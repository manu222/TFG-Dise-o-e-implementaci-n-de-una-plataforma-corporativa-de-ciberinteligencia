#!/bin/bash

# ==============================================================================
# SCRIPT DE GESTIÓN OPENCTI
# ==============================================================================

# --- CONFIGURACIÓN ---
CORE_DIR="/opt/opencti"
CONN_DIR="/opt/opencti/connectors"
ALLOWED_USER="opencti_svc"

# --- COLORES ANSI ---
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

# --- 1. CAPA DE SEGURIDAD ---
CURRENT_USER=$(whoami)

if [[ "$CURRENT_USER" != "root" && "$CURRENT_USER" != "$ALLOWED_USER" ]]; then
    echo -e "${RED}X ERROR CRÍTICO: Permiso denegado.${NC}"
    exit 1
fi

# --- FUNCIONES ---

check_dirs() {
    if [ ! -d "$CORE_DIR" ] || [ ! -d "$CONN_DIR" ]; then
        echo -e "${RED}X Error: No se encuentran los directorios.${NC}"
        exit 1
    fi
}

print_header() {
    echo -e "${BLUE}###############################################################${NC}"
    echo -e "${BLUE}#   ${CYAN}$1${NC}"
    echo -e "${BLUE}###############################################################${NC}"
}

# Esta función pinta la tabla según el estado
print_colored_table() {
    docker compose ps --format "table {{.Name}}\t{{.State}}\t{{.Status}}" | awk '
    NR==1 {print "\033[1;34m" $0 "\033[0m"; next}          # Cabecera en Azul
    /unhealthy/ {print "\033[1;31m" $0 "\033[0m"; next}    # Unhealthy en Rojo
    /Exited/ {print "\033[1;31m" $0 "\033[0m"; next}       # Exited en Rojo
    /restarting/ {print "\033[1;33m" $0 "\033[0m"; next}   # Restarting en Amarillo
    /starting/ {print "\033[1;33m" $0 "\033[0m"; next}     # Starting en Amarillo
    /healthy/ {print "\033[1;32m" $0 "\033[0m"; next}      # Healthy en Verde Brillante
    /running/ {print "\033[0;32m" $0 "\033[0m"; next}      # Running en Verde Normal
    {print $0}                                             # El resto normal
    '
}

start_system() {
    print_header "INICIANDO SISTEMA OPENCTI"
    echo -e "${GREEN}... [1/3] Levantando el Core...${NC}"
    cd "$CORE_DIR" && docker compose up -d
    
    echo -e "${YELLOW}... [2/3] Esperando 15 segundos para inicialización de BB.DD...${NC}"
    sleep 15
    
    echo -e "${GREEN}🔌 [3/3] Conectando los Workers y Conectores...${NC}"
    cd "$CONN_DIR" && docker compose up -d
    
    echo -e "\n${MAGENTA}OK Sistema iniciado correctamente.${NC}"
}

stop_system() {
    print_header "DETENIENDO SISTEMA OPENCTI"
    echo -e "${YELLOW}X [1/2] Desconectando Conectores...${NC}"
    cd "$CONN_DIR" && docker compose down
    
    echo -e "${RED}X [2/2] Apagando el Core...${NC}"
    cd "$CORE_DIR" && docker compose down
    
    echo -e "\n${WHITE}OK Sistema detenido.${NC}"
}

show_status() {
    echo -e ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║             📊  ESTADO DEL SISTEMA OPENCTI                   ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    
    echo -e "\n${BLUE}Core${NC} -> ${WHITE}$CORE_DIR${NC}"
    echo -e "${BLUE}────────────────────────────────────────────────────────────────${NC}"
    cd "$CORE_DIR" && print_colored_table
    
    echo -e "\n${MAGENTA}CONECTORES (Workers)${NC} -> ${WHITE}$CONN_DIR${NC}"
    echo -e "${MAGENTA}────────────────────────────────────────────────────────────────${NC}"
    cd "$CONN_DIR" && print_colored_table
    echo -e ""
}

# --- LÓGICA PRINCIPAL ---

check_dirs

case "$1" in
    start) start_system ;;
    stop) stop_system ;;
    restart) 
        print_header "REINICIO COMPLETO"
        stop_system
        sleep 2
        start_system
        ;;
    status) show_status ;;
    logs-core)
        echo -e "${CYAN}Logs Core (Ctrl+C para salir)...${NC}"
        cd "$CORE_DIR" && docker compose logs -f
        ;;
    logs-connectors)
        echo -e "${MAGENTA}Logs Conectores (Ctrl+C para salir)...${NC}"
        cd "$CONN_DIR" && docker compose logs -f
        ;;
    update-connectors)
        print_header "RECONSTRUYENDO CONECTORES"
        echo -e "${YELLOW}... Recompilando imágenes y actualizando cambios...${NC}"
        # El flag --build fuerza a Docker a leer tu código Python de nuevo
        cd "$CONN_DIR" && docker compose up -d --build
        echo -e "\n${GREEN}OK Conectores actualizados con el nuevo código.${NC}"
        ;;
    *)
        echo -e "${RED}Uso:${NC} opencti-control {start|stop|restart|status|logs-core|logs-connectors|update-connectors}"
        exit 1
        ;;
esac
exit 0
